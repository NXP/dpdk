 /* Port station interface a configuration register 0/2 */
 #define ENETC4_PSICFGR0(a)		((a) * 0x80 + 0x2010)
+#define  PSICFGR0_VTE			BIT(12)
+#define  PSICFGR0_SIVIE			BIT(14)
 #define  PSICFGR0_VASE			BIT(13)
 #define  PSICFGR0_ASE			BIT(15)
