+/* message format of class_id 0x24, cmd_id: 0x1,
+ * set SI-based VLAN insertion/removal (privileged VFs only)
+ *
+ * ctrl:        E[7]=1 enable, VTEA[6]=strip tag on Tx too, TPID[1:0]
+ * pcp_dei_vid_hi: PCP[7:5], DEI[4], VID[11:8] in bits[3:0]
+ * vid_lo:      VID[7:0]
+ * flags:       SVIE[2]=Tx insert enable, VTE[1]=Rx remove enable
+ */
+#define ENETC_SI_VLAN_ISO_CMD_SET	0x1
+
+#define ENETC_SI_VLAN_ISO_CTRL_E	BIT(7)
+#define ENETC_SI_VLAN_ISO_FLAGS_SVIE	BIT(2)
+#define ENETC_SI_VLAN_ISO_FLAGS_VTE	BIT(1)
+
+struct enetc_msg_si_vlan_iso {
+	struct enetc_msg_header hdr;
+	u8 ctrl;
+	u8 pcp_dei_vid_hi;
+	u8 vid_lo;
+	u8 reserved_0;
+	u8 flags;
+	u8 reserved_1[3];
+};
