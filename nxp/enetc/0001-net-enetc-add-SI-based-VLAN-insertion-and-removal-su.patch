diff --git a/drivers/net/ethernet/freescale/enetc/enetc_msg.c b/drivers/net/ethernet/freescale/enetc/enetc_msg.c
index 3862962e77d9..d93b4c2a9bb9 100644
--- a/drivers/net/ethernet/freescale/enetc/enetc_msg.c
+++ b/drivers/net/ethernet/freescale/enetc/enetc_msg.c
@@ -244,6 +244,37 @@ static u16 enetc_msg_handle_vlan_filter(struct enetc_msg_header *msg_hdr,
 	}
 }
 
+/* Handle SI VLAN isolation command from VF (class 0x24, cmd 0x1).
+ * Decodes ctrl/pcp_dei_vid_hi/vid_lo/flags from the message body and
+ * programs PSIaVLANR + PSIaCFGR0 for the requesting SI via the PF ops.
+ */
+static u16 enetc_msg_handle_si_vlan_iso(struct enetc_msg_header *msg_hdr,
+					struct enetc_pf *pf, int vf_id)
+{
+	struct enetc_msg_si_vlan_iso *msg;
+	struct enetc_hw *hw = &pf->si->hw;
+	bool enable;
+	u16 vid;
+	u8 pcp;
+
+	if (msg_hdr->cmd_id != ENETC_SI_VLAN_ISO_CMD_SET)
+		return ENETC_MSG_CODE_NOT_SUPPORT;
+
+	if (!pf->ops->set_si_vlan_iso)
+		return ENETC_MSG_CODE_NOT_SUPPORT;
+
+	msg = (struct enetc_msg_si_vlan_iso *)pf->rxmsg[vf_id].vaddr;
+
+	enable = !!(msg->ctrl & ENETC_SI_VLAN_ISO_CTRL_E);
+	vid = ((u16)(msg->pcp_dei_vid_hi & 0x0f) << 8) | msg->vid_lo;
+	pcp = (msg->pcp_dei_vid_hi >> 5) & 0x7;
+
+	/* si index for VF 0 is 1, VF 1 is 2, etc. */
+	pf->ops->set_si_vlan_iso(hw, vf_id + 1, enable, vid, pcp);
+
+	return ENETC_MSG_CODE_SUCCESS;
+}
