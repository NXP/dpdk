+/* enetc4_pf_set_si_vlan_iso - program SI-based VLAN insertion and removal.
+ * si is the SI index (VF 0 -> si=1, VF 1 -> si=2, ...).
+ * When enable=true: write VID+PCP to PSIaVLANR, set SIVIE+VTE in PSIaCFGR0.
+ * When enable=false: clear VID register and SIVIE+VTE bits.
+ */
+static void enetc4_pf_set_si_vlan_iso(struct enetc_hw *hw, int si,
+				      bool enable, u16 vid, u8 pcp)
+{
+	u32 vlanr, cfgr;
+
+	if (enable) {
+		vlanr = vid & PSIVLANR_VID;
+		vlanr = u32_replace_bits(vlanr, pcp, PSIVLANR_PCP);
+		vlanr |= PSIVLANR_E;
+		enetc_port_wr(hw, ENETC4_PSIVLANR(si), vlanr);
+
+		cfgr = enetc_port_rd(hw, ENETC4_PSICFGR0(si));
+		cfgr |= PSICFGR0_SIVIE | PSICFGR0_VTE;
+		enetc_port_wr(hw, ENETC4_PSICFGR0(si), cfgr);
+	} else {
+		cfgr = enetc_port_rd(hw, ENETC4_PSICFGR0(si));
+		cfgr &= ~(PSICFGR0_SIVIE | PSICFGR0_VTE);
+		enetc_port_wr(hw, ENETC4_PSICFGR0(si), cfgr);
+		enetc_port_wr(hw, ENETC4_PSIVLANR(si), 0);
+	}
+}
