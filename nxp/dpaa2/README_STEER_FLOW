===============================================================================
DPDK DPAA2 FLOW STEERING Program guide
===============================================================================
1. One level table(QoS table only)
   Direct traffic to specified TC's flow by QoS table only directly. This is
   the simplest program to steer flow and FS table can be disabled to save resource.

Example:
				QoS table
        +---------------+---------------+-------------+------------+
        |item(vlan prio)|item(IPv4 src) |item(UDP src)|  action    |
        +---------------+---------------+-------------+------------+
        |      1        |    1.1.1.1    |     xxxx    |TC0's flow1 |
        +---------------+---------------+-------------+------------+
        |      3        |    x.x.x.x    |     0x1234  |TC1's flow2 |
        +---------------+---------------+-------------+------------+
        |      x        |    4.4.4.4    |     xxxx    |TC3's flow0 |
        +---------------+---------------+-------------+------------+

	/**Entry 0*/
	memset(&flow_attr, 0, sizeof(struct rte_flow_attr));
	flow_attr.ingress = 1;
	flow_attr.group = 0xff;/** Force QoS flow*/
	flow_attr.priority = 0;/** Entry 0*/
	memset(&vlan_item, 0, sizeof(struct rte_flow_item_vlan));
	memset(&vlan_mask, 0, sizeof(struct rte_flow_item_vlan));
	vlan_item.hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_TCI_MAKE(0, 1, 0));
	vlan_mask.hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_PRI_MASK);
	memset(&ipv4_item, 0, sizeof(struct rte_flow_item_ipv4));
	memset(&ipv4_mask, 0, sizeof(struct rte_flow_item_ipv4));
	ipv4_item.hdr.src_addr = rte_cpu_to_be_32(0x01010101);
	ipv4_mask.hdr.src_addr = rte_cpu_to_be_32(0xffffffff);
	flow_item[0].spec = &vlan_item;
	flow_item[0].mask = &vlan_mask;
	flow_item[0].type = RTE_FLOW_ITEM_TYPE_VLAN;
	flow_item[1].spec = &ipv4_item;
	flow_item[1].mask = &ipv4_mask;
	flow_item[1].type = RTE_FLOW_ITEM_TYPE_IPV4;
	flow_item[2].type = RTE_FLOW_ITEM_TYPE_END;
	dest_queue.index = queue_id[0][1];/** queue ID of TC0-flow1*/
	flow_action[0].conf = &dest_queue;
	flow_action[0].type = RTE_FLOW_ACTION_TYPE_QUEUE;
	flow_action[1].type = RTE_FLOW_ACTION_TYPE_END;
	qos_flow[0] = rte_flow_create(port_id, &flow_attr, flow_item, flow_action, NULL);

	/**Entry 1*/
	memset(&flow_attr, 0, sizeof(struct rte_flow_attr));
	flow_attr.ingress = 1;
	flow_attr.group = 0xff;/** Force QoS flow*/
	flow_attr.priority = 1;/** Entry 1*/
	memset(&vlan_item, 0, sizeof(struct rte_flow_item_vlan));
	memset(&vlan_mask, 0, sizeof(struct rte_flow_item_vlan));
	vlan_item.hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_TCI_MAKE(0, 3, 0));
	vlan_mask.hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_PRI_MASK);
	memset(&udp_item, 0, sizeof(struct rte_flow_item_udp));
	memset(&udp_mask, 0, sizeof(struct rte_flow_item_udp));
	udp_item.hdr.src_port = rte_cpu_to_be_16(0x1234);
	udp_mask.hdr.src_port = rte_cpu_to_be_16(0xffff);
	flow_item[0].spec = &vlan_item;
	flow_item[0].mask = &vlan_mask;
	flow_item[0].type = RTE_FLOW_ITEM_TYPE_VLAN;
	flow_item[1].spec = &udp_item;
	flow_item[1].mask = &udp_mask;
	flow_item[1].type = RTE_FLOW_ITEM_TYPE_UDP;
	flow_item[2].type = RTE_FLOW_ITEM_TYPE_END;
	dest_queue.index = queue_id[1][2];/** queue ID of TC1-flow2*/
	flow_action[0].conf = &dest_queue;
	flow_action[0].type = RTE_FLOW_ACTION_TYPE_QUEUE;
	flow_action[1].type = RTE_FLOW_ACTION_TYPE_END;
	qos_flow[1] = rte_flow_create(port_id, &flow_attr, flow_item, flow_action, NULL);

	/**Entry 2*/
	memset(&flow_attr, 0, sizeof(struct rte_flow_attr));
	flow_attr.ingress = 1;
	flow_attr.group = 0xff;/** Force QoS flow*/
	flow_attr.priority = 2;/** Entry 2*/
	memset(&ipv4_item, 0, sizeof(struct rte_flow_item_ipv4));
	memset(&ipv4_mask, 0, sizeof(struct rte_flow_item_ipv4));
	ipv4_item.hdr.src_addr = rte_cpu_to_be_32(0x04040404);
	ipv4_mask.hdr.src_addr = rte_cpu_to_be_32(0xffffffff);
	flow_item[0].spec = &ipv4_item;
	flow_item[0].mask = &ipv4_mask;
	flow_item[0].type = RTE_FLOW_ITEM_TYPE_IPV4;
	flow_item[1].type = RTE_FLOW_ITEM_TYPE_END;
	dest_queue.index = queue_id[3][0];/** queue ID of TC3-flow0*/
	flow_action[0].conf = &dest_queue;
	flow_action[0].type = RTE_FLOW_ACTION_TYPE_QUEUE;
	flow_action[1].type = RTE_FLOW_ACTION_TYPE_END;
	qos_flow[2] = rte_flow_create(port_id, &flow_attr, flow_item, flow_action, NULL);

2. Two level tables(QoS table and FS table)
   Direct traffic to TC by QoS table then to flow by FS table.

Example:
   1) Direct traffic to TC by vlan priority extract of QoS table.
   2) Direct traffic to TC0's flow by IPv4 source address extract of TC0's FS table.
   3) Direct traffic by TC1's flow by UDP source port extract of TC1's FS table.


		QoS table
        +---------------+------+        +---------------FS table(TC2)
        |item(vlan prio)|action|        |	+---------------+------+
        +---------------+------+        |	|item(IPv4 src) |action|
        |      1        | TC2  |--------+	+---------------+------+
        +---------------+------+		|    1.1.1.2    |flow2 |
        |      4        | TC3  |--------+	+---------------+------+
        +---------------+------+        |	|    2.2.2.3    |flow3 |
					|	+---------------+------+
					|
					|
					+---------------FS table(TC3)
						+---------------+------+
						|item(UDP src)  |action|
						+---------------+------+
						|    0x1234     |flow3 |
						+---------------+------+
						|    0x5678     |flow4 |
						+---------------+------+

	/** QoS entry 0*/
	vlan_item[0].hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_TCI_MAKE(0, 1, 0));
	vlan_mask[0].hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_PRI_MASK);
	qos_item[0][0].spec = &vlan_item[0];
	qos_item[0][0].mask = &vlan_mask[0];
	qos_item[0][0].type = RTE_FLOW_ITEM_TYPE_VLAN;
	qos_item[0][1].type = RTE_FLOW_ITEM_TYPE_END;
	qos_action_tc[0] = 2;/** TC2*/

	/** QoS entry 1*/
	vlan_item[1].hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_TCI_MAKE(0, 4, 0));
	vlan_mask[1].hdr.vlan_tci = rte_cpu_to_be_16(RTE_VLAN_PRI_MASK);
	qos_item[1][0].spec = &vlan_item[1];
	qos_item[1][0].mask = &vlan_mask[1];
	qos_item[1][0].type = RTE_FLOW_ITEM_TYPE_VLAN;
	qos_item[1][1].type = RTE_FLOW_ITEM_TYPE_END;
	qos_action_tc[1] = 3;/** TC3*/

	/** FS2 entry 0*/
	ipv4_item[0].hdr.src_addr = rte_cpu_to_be_32(0x01010102);
	ipv4_mask[0].hdr.src_addr = rte_cpu_to_be_32(0xffffffff);
	fs_item[2][0][0].spec = &ipv4_item[0];
	fs_item[2][0][0].mask = &ipv4_mask[0];
	fs_item[2][0][0].type = RTE_FLOW_ITEM_TYPE_IPV4;
	fs_item[2][0][1].type = RTE_FLOW_ITEM_TYPE_END;
	fs_action_q[2][0] = queue_id[2][2];/** TC2-flow2*/

	/** FS2 entry 1*/
	ipv4_item[1].hdr.src_addr = rte_cpu_to_be_32(0x02020203);
	ipv4_mask[1].hdr.src_addr = rte_cpu_to_be_32(0xffffffff);
	fs_item[2][1][0].spec = &ipv4_item[1];
	fs_item[2][1][0].mask = &ipv4_mask[1];
	fs_item[2][1][0].type = RTE_FLOW_ITEM_TYPE_IPV4;
	fs_item[2][1][1].type = RTE_FLOW_ITEM_TYPE_END;
	fs_action_q[2][1] = queue_id[2][3];/** TC2-flow3*/

	/** FS3 entry 0*/
	udp_item[0].hdr.src_port = rte_cpu_to_be_16(0x1234);
	udp_mask[0].hdr.src_port = rte_cpu_to_be_16(0xffff);
	fs_item[3][0][0].spec = &udp_item[0];
	fs_item[3][0][0].mask = &udp_mask[0];
	fs_item[3][0][0].type = RTE_FLOW_ITEM_TYPE_UDP;
	fs_item[3][0][1].type = RTE_FLOW_ITEM_TYPE_END;
	fs_action_q[3][0] = queue_id[3][3];/** TC3-flow3*/

	/** FS3 entry 1*/
	udp_item[1].hdr.src_port = rte_cpu_to_be_16(0x5678);
	udp_mask[1].hdr.src_port = rte_cpu_to_be_16(0xffff);
	fs_item[3][1][0].spec = &udp_item[1];
	fs_item[3][1][0].mask = &udp_mask[1];
	fs_item[3][1][0].type = RTE_FLOW_ITEM_TYPE_UDP;
	fs_item[3][1][1].type = RTE_FLOW_ITEM_TYPE_END;
	fs_action_q[3][1] = queue_id[3][4];/** TC3-flow4*/

	for (qos_entry = 0; qos_entry < 2; qos_entry++) {
		memset(&flow_attr, 0, sizeof(struct rte_flow_attr));
		flow_attr.ingress = 1;
		flow_attr.group = 0xff;/** Force QoS flow*/
		flow_attr.priority = qos_entry;/** QoS Entry*/
		flow_action[0].type = RTE_FLOW_ACTION_TYPE_JUMP;
		action_jump.group = qos_action_tc[qos_entry];
		flow_action[0].conf = &action_jump;
		flow_action[1].type = RTE_FLOW_ACTION_TYPE_END;
		qos_flow[qos_entry] = rte_flow_create(port_id, &flow_attr, qos_item[qos_entry], flow_action, NULL);
		for (fs_entry = 0; fs_entry < 2; fs_entry++) {
			memset(&flow_attr, 0, sizeof(flow_attr));
			flow_attr.ingress = 1;
			flow_attr.group = action_jump.group;/** This is flow in QoS action TC's FS table*/
			flow_attr.priority = fs_entry;/** FS Entry*/
			flow_action[0].type = RTE_FLOW_ACTION_TYPE_QUEUE;
			dest_queue.index = fs_action_q[flow_attr.group][fs_entry];
			flow_action[0].conf = &dest_queue;
			flow_action[1].type = RTE_FLOW_ACTION_TYPE_END;
			fs_flow[fs_entry] = rte_dpaa2_flow_create(port_id, &flow_attr, fs_item[flow_attr.group][fs_entry],
				flow_action, NULL, RTE_DPAA2_FS_GROUP_FLOW);
		}
	}
